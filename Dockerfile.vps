# syntax=docker/dockerfile:1.7
# Lightweight 2-stage Dockerfile for 1 GB RAM VPS (uses prebuilt local dist/).

# Stage 1: Build minimal Python 3.12 virtualenv via uv -> /app/.venv
FROM python:3.12-slim AS backend
COPY --from=ghcr.io/astral-sh/uv:0.12.19 /uv /uvx /bin/
ENV UV_PYTHON_DOWNLOADS=0 \
    UV_LINK_MODE=copy
WORKDIR /app

COPY pyproject.toml uv.lock* ./
RUN if [ -f uv.lock ]; then \
        uv sync --frozen --no-dev --no-install-project --compile-bytecode || uv sync --no-dev --no-install-project --compile-bytecode; \
    else \
        uv sync --no-dev --no-install-project --compile-bytecode; \
    fi

# Stage 2: Minimal production runtime (non-root uid 10001, persistent /data volume)
FROM python:3.12-slim AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/app/.venv/bin:$PATH" \
    MARINA_DB_PATH="/data/marina_tracker.sqlite3" \
    PORT=10000

RUN apt-get update \
    && apt-get install -y --no-install-recommends tzdata ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 --shell /usr/sbin/nologin app

WORKDIR /app

# Copy compiled virtualenv, backend code, and prebuilt frontend dist/ only.
# Never bake .env or SQLite database files into the image.
COPY --from=backend /app/.venv /app/.venv
COPY app ./app
COPY dist ./dist

RUN python -m compileall -q /app/app \
    && mkdir -p /data /tmp/marina-tracker \
    && chown -R app:app /app /data /tmp/marina-tracker

USER app
EXPOSE 10000

CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-10000} --proxy-headers --forwarded-allow-ips='*'"]
